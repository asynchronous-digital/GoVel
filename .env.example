APP_NAME=Govel
APP_ENV=local
APP_DEBUG=true
APP_PORT=8000
APP_KEY=base64:changeme

# Database Configuration
# Drivers: sqlite, mysql, postgres
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=govel
DB_USERNAME=root
DB_PASSWORD=
DB_SSL_MODE=disable

# Cache Configuration
# Drivers: memory, file, database, redis
CACHE_DRIVER=memory
CACHE_PREFIX=govel_cache_

# Session Configuration
# Drivers: cookie, file, database
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=govel_session

# Queue Configuration
# Drivers: sync, database, redis
QUEUE_DRIVER=sync
QUEUE_PREFIX=govel_queue

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@govel.local
MAIL_FROM_NAME="Govel"

# AWS S3 (for future file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Redis (for future caching/queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# API Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=1m

# Security
CORS_ALLOWED_ORIGINS=*
CSRF_ENABLED=true

# Feature Flags
ENABLE_PROFILING=false
ENABLE_DEBUG_ROUTES=true
